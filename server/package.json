{
  "name": "react-native-final-project-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db && npm run migrate",
    "db:psql": "docker compose exec db psql -U market -d market",
    "db:logs": "docker compose logs -f db",
    "mail:up": "docker compose up -d mailpit",
    "storage:setup": "tsx --env-file-if-exists=.env src/db/storageSetup.ts",
    "storage:migrate": "tsx --env-file-if-exists=.env src/db/storageMigrate.ts",
    "mail:test": "tsx --env-file-if-exists=.env src/db/mailTest.ts",
    "db:generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed:catalog": "tsx --env-file-if-exists=.env src/db/seedCatalog.ts",
    "db:seed:reviews": "tsx --env-file-if-exists=.env src/db/seedReviews.ts",
    "admin:grant": "tsx --env-file-if-exists=.env src/db/grantAdmin.ts",
    "sepay:simulate": "tsx --env-file-if-exists=.env src/db/simulateSepay.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "nodemailer": "^10.5.0",
    "postgres": "^4.1.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
