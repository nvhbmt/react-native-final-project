# Sao chép thành .env rồi chỉnh. File .env không được commit.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://market:market@localhost:5435/market

# Bắt buộc, tối thiểu 32 ký tự. Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Thời hạn token (giây)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Danh sách origin được phép gọi API từ web (Expo web chạy :8081), phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:8081

# Chat AI (chưa dùng — để sẵn cho giai đoạn tích hợp)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
