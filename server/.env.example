# Sao chép thành .env rồi chỉnh. File .env không được commit.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://market:market@localhost:5435/market

# Bắt buộc, tối thiểu 32 ký tự. Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Thời hạn token (giây)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Danh sách origin được phép gọi API từ web (Expo web chạy :8081), phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:8081

# Email gửi mã đặt lại mật khẩu. Để trống thì mã được in ra console của server (dev).
# Ví dụ Gmail (App Password): smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=Market <no-reply@market.local>

# Thư mục lưu ảnh upload (avatar, góp ý). Production nên trỏ tới volume bền vững.
UPLOAD_DIR=uploads

# Thanh toán SePay (chuyển khoản VietQR). Để trống SEPAY_WEBHOOK_API_KEY thì tắt.
# Trên my.sepay.vn: thêm tài khoản ngân hàng, tạo Webhook trỏ về https://<domain>/api/v1/payments/webhook,
# chọn chứng thực "API Key" và dán cùng giá trị vào đây. Cấu trúc mã thanh toán: tiền tố SEPAY_CODE_PREFIX + 8 ký tự.
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK=MBBank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_CODE_PREFIX=DH
SEPAY_PAYMENT_TTL_MINUTES=30
# Catalog định giá USD; quy đổi sang VND khi thanh toán
USD_TO_VND_RATE=25000

# Chat AI (chưa dùng — để sẵn cho giai đoạn tích hợp)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
