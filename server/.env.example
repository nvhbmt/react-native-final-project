# Sao chép thành .env rồi chỉnh. File .env không được commit.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://market:market@localhost:5435/market

# Bắt buộc, tối thiểu 32 ký tự. Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Thời hạn token (giây)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Danh sách origin được phép gọi API từ web (Expo web chạy :8081), phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:8081

# Email gửi mã đặt lại mật khẩu. Để trống thì mã được in ra console của server (dev).
# Ví dụ Gmail (App Password): smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# Email — chọn MỘT cách (không đặt gì thì in email ra console):
# (1) Gmail App Password (https://myaccount.google.com/apppasswords, cần bật Xác minh 2 bước):
#     SMTP_USER=dia-chi@gmail.com  SMTP_PASS=xxxx xxxx xxxx xxxx  (mặc định smtp.gmail.com:465, người gửi MobiMart <SMTP_USER>)
# (2) SMTP_URL, vd. Mailpit dev: smtp://localhost:1025
# Kiểm tra: npm run mail:test  (thêm -- <email> để gửi thư thử)
SMTP_USER=
SMTP_PASS=
SMTP_URL=
# Tuỳ chọn: SMTP_HOST/SMTP_PORT cho nhà cung cấp khác; MAIL_FROM để đổi người gửi
MAIL_FROM=

# Thư mục lưu ảnh upload (avatar, góp ý). Production nên trỏ tới volume bền vững.
UPLOAD_DIR=uploads
# Lưu ảnh bền vững trên Supabase Storage (khuyên dùng khi deploy; thiếu thì lưu ổ đĩa UPLOAD_DIR và mất khi deploy lại).
# SUPABASE_URL: Project URL (Settings → API), vd. https://abcd1234.supabase.co
# SUPABASE_SECRET_KEY: Secret key `sb_secret_…` (Project Settings → API Keys). Chỉ đặt ở server, KHÔNG đưa vào app/EXPO_PUBLIC_*.
# Sau đó: npm run storage:setup (tạo bucket public), npm run storage:migrate -- --apply (chuyển ảnh cũ).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Thanh toán SePay (chuyển khoản VietQR). Để trống SEPAY_WEBHOOK_API_KEY thì tắt.
# Trên my.sepay.vn: thêm tài khoản ngân hàng, tạo Webhook trỏ về https://<domain>/api/v1/payments/webhook,
# chọn chứng thực "API Key" và dán cùng giá trị vào đây. Cấu trúc mã thanh toán: tiền tố SEPAY_CODE_PREFIX + 8 ký tự.
SEPAY_WEBHOOK_API_KEY=
# Ví dụ khi bật SePay: SEPAY_BANK=MBBank
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_CODE_PREFIX=MM
SEPAY_PAYMENT_TTL_MINUTES=30
# Thử luồng ở máy dev không cần SePay thật: true + điền tài khoản giả bất kỳ, rồi `npm run sepay:simulate`
# để gửi webhook giả. App hiện cảnh báo "không chuyển tiền thật". Không bật trên production.
SEPAY_SIMULATED=false
# Catalog định giá USD; quy đổi sang VND khi thanh toán
USD_TO_VND_RATE=25000

# Trợ lý AI. Claude dùng Anthropic Messages API trực tiếp; key chỉ đặt ở server.
# Claude: AI_PROVIDER=anthropic, AI_MODEL=claude-haiku-5-5, để trống AI_BASE_URL.
# Provider Chat Completions khác: AI_PROVIDER=openai-compatible và điền AI_BASE_URL.
# Để trống key/model thì tính năng chat trả 503 AI_UNAVAILABLE.
AI_PROVIDER=anthropic
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
