{
  "expo": {
    "name": "MobiMart",
    "slug": "mobimart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nvhbmt.mobimart"
    },
    "android": {
      "package": "com.nvhbmt.mobimart",
      "adaptiveIcon": {
        "backgroundColor": "#00BDD6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MobiMart cần truy cập ảnh để bạn đổi ảnh đại diện và đính kèm ảnh khi gửi góp ý.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "mobimart",
    "experiments": {
      "typedRoutes": true
    }
  }
}
